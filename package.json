{
  "name": "childcare",
  "private": true,
  "scripts": {
    "dev": "granite dev",
    "build": "ait build",
    "deploy": "ait deploy",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsc -p tsconfig.test.json && node --test .tmp-test/core/**/*.test.js",
    "test:rn": "jest",
    "sim": "tsc -p tsconfig.test.json && node .tmp-test/core/sim/run.js",
    "preview": "vite build && vite preview --port 4173 --strictPort",
    "shots": "vite build && (vite preview --port 4173 --strictPort & sleep 4 && node web/shots.mjs; kill %1)"
  },
  "dependencies": {
    "@apps-in-toss/framework": "^2.10.8",
    "@granite-js/native": "1.0.37",
    "@granite-js/react-native": "1.0.37",
    "@toss/tds-react-native": "^2.0.4",
    "brick-module": "0.5.1",
    "react": "19.2.3",
    "react-native": "0.84.0"
  },
  "devDependencies": {
    "@babel/core": "7.28.5",
    "@babel/runtime": "7.28.4",
    "@eslint/js": "^9.17.0",
    "@granite-js/plugin-hermes": "1.0.37",
    "@granite-js/plugin-router": "1.0.37",
    "@testing-library/react-native": "13.3.3",
    "@types/babel__core": "^7.20.5",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/react": "19.2.0",
    "@types/react-dom": "^19.2.3",
    "@types/react-test-renderer": "19.1.0",
    "@vitejs/plugin-react": "^6.0.4",
    "babel-preset-granite": "1.0.37",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.2",
    "jest": "^29.7.0",
    "playwright": "^1.62.0",
    "prettier": "3.4.2",
    "react-dom": "^19.2.3",
    "react-native-web": "^0.21.2",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.0",
    "vite": "^8.1.5"
  },
  "dependenciesMeta": {
    "hermes-compiler": {
      "unplugged": true
    }
  }
}
